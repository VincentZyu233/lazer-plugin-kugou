{
  "id": "lazer.kugou",
  "name": "酷狗音乐",
  "version": "0.2.1",
  "description": "专为 Lazer 打造的酷狗音乐 Lua Gateway 插件，支持 KRC 逐字动感歌词与双语翻译、歌曲评论区、高品质音频流、云端收藏、歌单电台及扫码/短信双轨登录。",
  "author": "VincentZyu",
  "entry": "main.lua",
  "apiVersion": 1,
  "provider": "kugou",
  "capabilities": [
    "search",
    "lyrics",
    "playlists",
    "favorites",
    "comments",
    "homeFeed",
    "radio",
    "recommendations"
  ],
  "auth": [
    "qr",
    "sms"
  ],
  "permissions": {
    "network": [
      "*.kugou.com"
    ],
    "storage": true
  }
}
